# Local SQLite
SQLITE_PATH=olx_monitor.sqlite3

# Telegram Bot
TELEGRAM_BOT_TOKEN=
# Optional. The bot normally discovers the chat when you send /start.
TELEGRAM_CHAT_ID=

# Search timing. Keep conservative to reduce OLX blocking risk.
SCAN_INTERVAL_SECONDS=1800
DELAY_BETWEEN_ALERT_REQUESTS_SECONDS=90
DELAY_BETWEEN_PAGE_REQUESTS_SECONDS=15
MAX_SEARCH_PAGES=3
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRIES=2
REQUEST_BACKOFF_SECONDS=1.5
MAX_LISTING_AGE_DAYS=30
DEBUG_DUMP_DIR=debug_dumps

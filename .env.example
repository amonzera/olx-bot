# Local SQLite
SQLITE_PATH=olx_monitor.sqlite3

# Optional Postgres, only used if you intentionally enable the extras profile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=olx_monitor
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Optional Redis/Celery, not needed for the local monitor flow
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scraping Limits
DELAY_BETWEEN_REQUESTS_SECONDS=5
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRIES=2
REQUEST_BACKOFF_SECONDS=1.5
MAX_LISTING_AGE_DAYS=30
DEBUG_DUMP_DIR=debug_dumps
